{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hamza-and-komal-walima-invitation.vercel.app"
        }
      ],
      "destination": "https://hamza-walima-invitation.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hamza-and-komal-walima-invitation.vercel.app"
        }
      ],
      "destination": "https://hamza-walima-invitation.vercel.app/:path*",
      "permanent": true
    }
  ]
}
